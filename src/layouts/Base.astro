---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { business as b, nav, towns } from '../data/site';

const { title, description, noindex = false, services = [], crumb: crumbName, parents = [] } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, b.url).href;
const pageTitle = path === '/' ? title : `${title} | ${b.name}`;
const ogImage = `${b.url}/og.jpg`;
const ogImageAlt = 'Gray double garage door with a row of windows on a brick home';

const businessId = `${b.url}/#business`;
const websiteId = `${b.url}/#website`;
const crumb = crumbName ?? nav.find((n) => n.href === path)?.label ?? title;
const trail = [{ name: 'Home', item: `${b.url}/` }, ...parents.map((p) => ({ name: p.name, item: new URL(p.href, b.url).href })), { name: crumb, item: canonical }];

const graph = [
  {
    '@type': 'HomeAndConstructionBusiness',
    '@id': businessId,
    name: b.legalName,
    alternateName: [b.name, 'AAA Door & Trim'],
    description: 'Garage door and commercial door repair, installation and 24/7 emergency service in Southeast Texas and Southwest Louisiana.',
    url: `${b.url}/`,
    telephone: '+1-409-344-4505',
    image: ogImage,
    logo: `${b.url}/logo.png`,
    foundingDate: String(b.since),
    address: { '@type': 'PostalAddress', streetAddress: b.street, addressLocality: b.city, addressRegion: b.region, postalCode: b.zip, addressCountry: 'US' },
    openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:00', closes: '17:00' },
    areaServed: [...towns.TX.map((t) => `${t}, TX`), ...towns.LA.map((t) => `${t}, LA`)].map((name) => ({ '@type': 'City', name })),
    sameAs: [...Object.values(b.social), b.bbbUrl],
  },
  { '@type': 'WebSite', '@id': websiteId, url: `${b.url}/`, name: b.name, inLanguage: 'en-US', publisher: { '@id': businessId } },
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: pageTitle, description, inLanguage: 'en-US', isPartOf: { '@id': websiteId }, about: { '@id': businessId } },
  ...(path === '/' || noindex ? [] : [{
    '@type': 'BreadcrumbList',
    itemListElement: trail.map((t, i) => ({ '@type': 'ListItem', position: i + 1, ...t })),
  }]),
  ...services.map((s) => ({ '@type': 'Service', name: s.name, description: s.text, provider: { '@id': businessId }, ...(s.areaServed ? { areaServed: s.areaServed } : {}) })),
];
const schema = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta name="author" content={b.legalName} />
  <meta name="application-name" content={b.name} />
  <meta name="geo.region" content="US-TX" />
  <meta name="geo.placename" content={`${b.city}, Texas`} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#14171B" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content={b.legalName} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="topbar">
    <div class="wrap topbar__in">
      <p class="status" data-status>Mon to Fri, 7:00 AM to 5:00 PM</p>
      <p class="topbar__emergency">24/7 emergency service: <a href={b.phoneHref}>{b.phoneDisplay}</a></p>
    </div>
  </div>
  <header class="header">
    <div class="wrap header__in">
      <a class="brand" href="/" aria-label={`${b.name} home`}>
        <Logo class="brand__mark" />
        <span class="brand__word">AAA Door</span>
      </a>
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="header__cta">
        <a class="btn btn--ghost" href="/contact-us/">Get a free quote</a>
        <a class="btn btn--red" href={b.phoneHref}>Call {b.phoneDisplay}</a>
      </div>
      <details class="menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a href="/contact-us/">Contact</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main"><slot /></main>

  <section class="closer">
    <div class="wrap closer__in">
      <h2>Door trouble? Talk to someone local.</h2>
      <div class="actions">
        <a class="btn btn--white" href={b.phoneHref}>Call {b.phoneDisplay}</a>
        <a class="btn btn--outline" href="/contact-us/">Get a free quote</a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <a class="brand brand--light" href="/" aria-label={`${b.name} home`}>
          <Logo class="brand__mark" />
          <span class="brand__word">AAA Door</span>
        </a>
        <address>{b.street}<br />{b.city}, {b.region} {b.zip}</address>
        <p><a href={b.phoneHref}>{b.phoneDisplay}</a></p>
      </div>
      <div>
        <h3>Hours</h3>
        <p>Monday to Friday<br />7:00 AM to 5:00 PM</p>
        <p>Closed weekends and major holidays. Emergency service 24/7.</p>
      </div>
      <div>
        <h3>Explore</h3>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/contact-us/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h3>Find us</h3>
        <ul>
          {Object.entries(b.social).map(([k, v]) => <li><a href={v} rel="noopener">{k}</a></li>)}
          <li><a href={b.bbbUrl} rel="noopener">BBB profile</a></li>
        </ul>
      </div>
    </div>
    <p class="wrap footer__legal">© {new Date().getFullYear()} {b.legalName}. All rights reserved.</p>
  </footer>

  <div class="callbar">
    <a class="btn btn--red" href={b.phoneHref}>Call now</a>
    <a class="btn btn--dark" href="/contact-us/">Free quote</a>
  </div>

  <script is:inline>
    (function () {
      var el = document.querySelector('[data-status]');
      if (!el || !window.Intl) return;
      var p = {};
      new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', weekday: 'short', hour: 'numeric', hourCycle: 'h23' })
        .formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
      var open = !/Sat|Sun/.test(p.weekday) && +p.hour >= 7 && +p.hour < 17;
      el.textContent = open ? 'Open today until 5:00 PM' : 'Office closed. Emergency line open now';
      el.classList.add(open ? 'is-open' : 'is-closed');
    })();
  </script>
</body>
</html>
