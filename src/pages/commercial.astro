---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Services from '../components/Services.astro';
import { business as b, commercial } from '../data/site';
---
<Base title="Commercial Door Repair & Installation" services={commercial} description="Commercial roll-up and sectional doors, motor operators, hollow metal doors, closers and panic hardware for businesses in Southeast Texas and Louisiana.">
  <PageHead title="Commercial door repair and installation" lead="Overhead doors, entries and exits for businesses in Southeast Texas and Southwest Louisiana, with 24/7 emergency service." />
  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Commercial services</h2>
      <Services items={commercial} />
    </div>
  </section>
  <section class="section section--tint">
    <div class="wrap feature feature--text">
      <div>
        <h2>Fix problems before they shut you down</h2>
        <p class="lede">An annual or bi-annual maintenance contract puts your doors on a regular schedule, so we find worn parts on a planned visit and not on your busiest day.</p>
      </div>
      <div class="actions">
        <a class="btn btn--red" href="/contact-us/">Ask about a contract</a>
        <a class="btn btn--ghost" href={b.phoneHref}>Call {b.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>
