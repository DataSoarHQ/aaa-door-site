---
import { business as b } from '../data/site';
import { areas, areaHref } from '../data/areas';
const { heading: H = 'h2' } = Astro.props;
---
<div class="towns" data-towns>
  <H class="towns__q"><label for="town">Do we come to your town?</label></H>
  <input id="town" type="text" autocomplete="address-level2" placeholder="Type your town" data-town-input />
  <p class="towns__answer" role="status" data-town-answer>We serve {areas.length} towns across Southeast Texas and Southwest Louisiana.</p>
  <ul class="towns__list" data-town-list>
    {areas.map((a) => <li data-town={a.name.toLowerCase()}><a href={areaHref(a)}>{a.name}, {a.state}</a></li>)}
  </ul>
</div>
<script is:inline define:vars={{ phone: b.phoneDisplay }}>
  (function () {
    var box = document.querySelector('[data-towns]');
    var input = box.querySelector('[data-town-input]');
    var answer = box.querySelector('[data-town-answer]');
    var items = Array.prototype.slice.call(box.querySelectorAll('[data-town]'));
    var start = answer.textContent;
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase().replace(/[,.].*$/, '');
      var hits = items.filter(function (li) {
        var on = !q || li.dataset.town.indexOf(q) === 0;
        li.hidden = !on;
        li.classList.toggle('is-hit', !!q && on);
        return on;
      });
      if (!q) answer.textContent = start;
      else if (hits.length) answer.textContent = hits.length === 1 ? 'Yes, we serve ' + hits[0].textContent + '.' : 'Yes, we serve ' + hits.map(function (h) { return h.textContent; }).join(' and ') + '.';
      else answer.textContent = 'That town isn’t on our regular list. Call ' + phone + ' and ask, we may still be able to help.';
    });
  })();
</script>
