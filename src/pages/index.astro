---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Reviews from '../components/Reviews.astro';
import TownChecker from '../components/TownChecker.astro';
import Slots from '../components/Slots.astro';
import { business as b, residential, commercial, team } from '../data/site';
import { jobs, styles } from '../data/photos';

const ticker = [
  { label: 'Free Inspections', href: '/contact-us/' },
  { label: 'Residential Services', href: '/residential/' },
  { label: 'Commercial Services', href: '/commercial/' },
  { label: '24/7 Emergency Services', href: b.phoneHref },
  { label: `Call Now ${b.phoneDisplay}`, href: b.phoneHref },
];

const trouble = [
  { q: 'A spring or cable snapped', a: 'A loud bang followed by a door that feels too heavy usually means a broken spring. Leave the door where it is and don’t pull on it. Springs and cables hold serious tension and can hurt you.' },
  { q: 'The door won’t open or close', a: 'If your car is stuck inside or the door won’t shut, call us. Emergency service runs 24/7, so you don’t have to wait for Monday morning.' },
  { q: 'The opener stopped working', a: 'First check that it has power and that nothing is blocking the safety sensors near the floor. If it still won’t run, we can repair the motor operator or replace it.' },
  { q: 'The door is off track or got hit', a: 'Stop using it and keep people and cars clear, because a door off its track can fall. We’ll fix the track, rollers and panels, or replace the door if it’s past saving.' },
  { q: 'My business door is down', a: 'We handle roll-up and sectional doors, motor operators, door closers, panic hardware and hollow metal doors, day or night.' },
  { q: 'I just want a new door', a: 'Good timing to look around. Browse door styles in the gallery, then ask for a free quote and we’ll come out to measure and go over your options.' },
];
---
<Base title="AAA Door LLC | Garage Door Repair & Installation in Orange, TX" description="Garage door repair and installation for homes and businesses in Orange, Beaumont and Port Arthur, TX. 24/7 emergency service. Call 409-344-4505.">
  <script is:inline slot="head">
    try { if (sessionStorage.getItem('aaaDoor')) document.documentElement.classList.add('door-seen'); sessionStorage.setItem('aaaDoor', '1'); } catch (e) {}
  </script>

  <section class="hero">
    <div class="hero__copy">
      <h1>Garage door repair in Orange, Beaumont &amp; Southeast Texas</h1>
      <p class="hero__lead">Garage door repair, new doors and motor operators for homes and businesses in Orange, Beaumont, Port Arthur and across Southeast Texas and Southwest Louisiana. On call 24/7 for emergencies.</p>
      <div class="actions">
        <a class="btn btn--red btn--lg" href={b.phoneHref}>Call {b.phoneDisplay}</a>
        <a class="btn btn--ghost btn--lg" href="/contact-us/">Get a free quote</a>
      </div>
    </div>
    <div class="hero__photo" data-photo-door>
      <Image src={jobs[0].src} alt={jobs[0].alt} widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 55vw" loading="eager" fetchpriority="high" />
      {/* The door in the photo, traced in the photo's own pixels (2496x1580), so it can roll up.
          The photo is perspective-corrected, so the opening and the door are plain, level rectangles. */}
      <svg class="photo-door" viewBox="0 0 2496 1580" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <clipPath id="door-opening"><rect x="92" y="334" width="1971" height="994" /></clipPath>
          <clipPath id="door-slab"><rect x="86" y="328" width="1983" height="1006" /></clipPath>
          <linearGradient id="garage-dark" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#050608" />
            <stop offset=".65" stop-color="#16191c" />
            <stop offset="1" stop-color="#34373a" />
          </linearGradient>
          <radialGradient id="garage-light" cx="1078" cy="430" r="950" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ffe7ad" stop-opacity=".8" />
            <stop offset=".3" stop-color="#ffd27a" stop-opacity=".25" />
            <stop offset="1" stop-color="#ffd27a" stop-opacity="0" />
          </radialGradient>
        </defs>
        <g clip-path="url(#door-opening)">
          <rect x="0" y="0" width="2496" height="1580" fill="url(#garage-dark)" />
          <g fill="none" stroke="#2a2e33" stroke-width="12">
            <path d="M92 380 H2063 M92 430 H2063" />
            <path d="M1078 380 V460" />
          </g>
          <rect x="998" y="460" width="160" height="60" rx="6" fill="#23272c" />
          <rect class="photo-door__bulb" x="1038" y="520" width="80" height="14" rx="7" fill="#fff3cf" />
          <rect class="photo-door__glow" x="0" y="0" width="2496" height="1580" fill="url(#garage-light)" />
          <g class="photo-door__slab">
            <image href="" width="2496" height="1580" clip-path="url(#door-slab)" />
          </g>
        </g>
      </svg>
      <button class="opener" type="button" aria-pressed="false" data-opener>
        <span class="opener__btn" aria-hidden="true"></span>
        <span class="opener__label">Open the door</span>
      </button>
    </div>
    <script is:inline>
      (function () {
        var box = document.querySelector('[data-photo-door]');
        var img = box.querySelector('img');
        var slab = box.querySelector('.photo-door image');
        var btn = box.querySelector('[data-opener]');
        var label = btn.querySelector('.opener__label');
        function ready() { slab.setAttribute('href', img.currentSrc || img.src); box.classList.add('is-ready'); }
        if (img.complete && img.naturalWidth) ready(); else img.addEventListener('load', ready, { once: true });
        function toggle() {
          var open = !box.classList.contains('is-open');
          box.classList.toggle('is-open', open);
          btn.setAttribute('aria-pressed', String(open));
          label.textContent = open ? 'Close the door' : 'Open the door';
          btn.classList.add('was-used');
        }
        btn.addEventListener('click', toggle);
        box.querySelector('svg').addEventListener('click', toggle);
      })();
    </script>
    <div class="curtain" aria-hidden="true">
      <div class="curtain__panel"></div>
      <div class="curtain__panel curtain__panel--windows"></div>
      <div class="curtain__panel"></div>
      <div class="curtain__panel"></div>
      <div class="curtain__panel"></div>
      <Logo class="curtain__logo" />
    </div>
  </section>

  <div class="ticker" aria-label="Our services">
    <div class="ticker__track">
      {[0, 1].map((copy) => (
        <ul class="ticker__group" aria-hidden={copy ? 'true' : undefined}>
          {[0, 1].flatMap(() => ticker).map((t) => (
            <li><a href={t.href} tabindex={copy ? -1 : undefined}>{t.label}</a><span class="ticker__sep" aria-hidden="true"></span></li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <ul class="proof wrap" aria-label="Why customers choose us" data-proof>
    <li><strong><Slots text={`${b.rating} stars`} /></strong><span><Slots text={`${b.reviewCount}`} /> customer reviews</span></li>
    <li><strong><Slots text="A+ with BBB" /></strong><span>Accredited since <Slots text="2018" /></span></li>
    <li><strong><Slots text="24/7" /></strong><span>Emergency service</span></li>
    <li><strong>Since <Slots text={`${b.since}`} /></strong><span>Family owned in Orange, TX</span></li>
  </ul>
  <script is:inline>
    (function () {
      var list = document.querySelector('[data-proof]');
      if (!list || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      list.classList.add('slots-armed');
      function spin(el) {
        el.classList.remove('is-spinning', 'is-landed');
        void el.offsetWidth;
        el.classList.add('is-spinning');
        var reels = el.querySelectorAll('.reel');
        var slowest = reels[0];
        reels.forEach(function (r) { if (+r.style.getPropertyValue('--i') >= +slowest.style.getPropertyValue('--i')) slowest = r; });
        if (slowest) slowest.addEventListener('animationend', function () { el.classList.add('is-landed'); }, { once: true });
      }
      function start() {
        // Let the hero door finish rolling up before the reels go.
        var wait = document.documentElement.classList.contains('door-seen') ? 150 : Math.max(150, 1700 - performance.now());
        setTimeout(function () {
          list.querySelectorAll('li').forEach(function (li, i) { setTimeout(function () { spin(li); }, i * 180); });
        }, wait);
      }
      var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { io.disconnect(); start(); } }, { threshold: 0.5 });
      io.observe(list);
      // Pull the lever again: click a stat to respin it.
      list.addEventListener('click', function (e) { var li = e.target.closest('li'); if (li) spin(li); });
    })();
  </script>

  <section class="section trouble">
    <div class="wrap trouble__grid">
      <div>
        <h2>What’s your garage door doing?</h2>
        <p class="lede">Pick what’s closest and we’ll tell you what to do next.</p>
      </div>
      <div class="accordion">
        {trouble.map((t, i) => (
          <details name="trouble" open={i === 0}>
            <summary>{t.q}</summary>
            <div class="accordion__body">
              <p>{t.a}</p>
              <p class="accordion__cta"><a class="link" href={b.phoneHref}>Call {b.phoneDisplay}</a></p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Garage door services for homes and businesses</h2>
      <div class="split">
        <div class="split__col">
          <h2>Residential garage door services</h2>
          <ul class="ticks">{residential.slice(0, 7).map((s) => <li>{s.name}</li>)}</ul>
          <a class="btn btn--dark" href="/residential/">See residential services</a>
        </div>
        <div class="split__col">
          <h2>Commercial door services</h2>
          <ul class="ticks">{commercial.slice(0, 7).map((s) => <li>{s.name}</li>)}</ul>
          <a class="btn btn--dark" href="/commercial/">See commercial services</a>
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <section class="section">
    <div class="wrap">
      <div class="heading-row">
        <h2>Garage doors we install</h2>
        <a class="link" href="/gallery/">See the full gallery</a>
      </div>
      <div class="strip">
        {[styles[0], styles[1], styles[2], styles[3]].map((p) => (
          <a href="/gallery/"><Image src={p.src} alt={p.alt} widths={[400, 700]} sizes="(max-width: 700px) 80vw, 25vw" /></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap"><TownChecker /></div>
  </section>

  <section class="section">
    <div class="wrap about-teaser">
      <div>
        <h2>A small, family-run crew</h2>
        <p class="lede">AAA Door LLC is family owned and operated. We’d rather have your business for good than just this once, so we explain what’s wrong, give you the price in writing and stand behind the work.</p>
        <a class="link" href="/about-us/">Meet the team</a>
      </div>
      <ul class="team">
        {team.map((t) => <li><strong>{t.name}</strong><span>{t.role}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section google" slot="before-footer" aria-labelledby="google-title">
    <div class="wrap">
      <div class="heading-row">
        <h2 id="google-title">Find us on Google</h2>
        <a class="btn btn--dark" href={b.googleUrl} rel="noopener">View us on Google</a>
      </div>
      <p class="lede">{b.legalName}, {b.street}, {b.city}, {b.region} {b.zip}</p>
      <iframe class="google__map" src={`https://www.google.com/maps?q=${encodeURIComponent(`${b.legalName}, ${b.street}, ${b.city}, ${b.region} ${b.zip}`)}&output=embed`} title="AAA Door LLC on Google Maps" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </section>
</Base>
