---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Reviews from '../components/Reviews.astro';
import { team } from '../data/site';
import { jobs } from '../data/photos';
---
<Base title="About Us" description="AAA Door is a family-owned garage door company in Orange, TX, led by Nick Vitale. Meet the team behind the repairs and installs.">
  <PageHead title="Local, family owned and easy to reach" lead="AAA Door has been fixing and installing doors from Orange, TX since 2014." />
  <section class="section">
    <div class="wrap feature">
      <div>
        <h2>Meet Nick</h2>
        <p class="lede">Nick Vitale brings more than 20 years of hands-on experience in operations, administration and customer service to every job. He cares about three things: quality workmanship, integrity and customers who are glad they called.</p>
        <p>Customers know Nick for clear communication and for doing what he says he’ll do. He’ll explain what’s wrong in plain language, tell you your options and treat you like a partner, not a work order.</p>
      </div>
      <Image src={jobs[1].src} alt={jobs[1].alt} widths={[500, 1000]} sizes="(max-width: 900px) 100vw, 50vw" />
    </div>
  </section>
  <section class="section section--tint">
    <div class="wrap">
      <h2>The team</h2>
      <ul class="team team--row">
        {team.map((t) => <li><strong>{t.name}</strong><span>{t.role}</span></li>)}
      </ul>
    </div>
  </section>
  <Reviews />
</Base>
